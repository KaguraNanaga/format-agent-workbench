# Format Agent Workbench
# 内置演示不需要填写以下三项。处理你自己的自然语言要求时才需要模型配置。

# OpenAI Chat Completions 兼容接口，例如 https://api.openai.com/v1
LLM_BASE_URL=
LLM_API_KEY=

# 完整工作流需要能同时理解文字和图片、并稳定输出 JSON 的多模态模型。
LLM_MODEL=

# 默认以内联 base64 传输页面图片，不上传公共图床。
# 只有明确接受相关隐私风险时才改为 true。
LLM_ALLOW_PUBLIC_IMAGE_UPLOAD=false

LLM_TIMEOUT=120
LLM_MAX_TOKENS=4096
LLM_VISION_PAGES_PER_REQUEST=3
LLM_VISION_MAX_BYTES=5000000

# 可选：找不到 LibreOffice 时填写 soffice 可执行文件的完整路径。
# Windows 示例：C:\Program Files\LibreOffice\program\soffice.exe
# macOS 示例：/Applications/LibreOffice.app/Contents/MacOS/soffice
LIBREOFFICE_PATH=

# 可选：缺少中文字体时用于替代的字体名。
LIBREOFFICE_CJK_FALLBACK_FONT=
